# Copy this file to .env.local for local development.
# On Vercel, Blob and Resend Marketplace integrations usually inject these automatically.

# Required for quote photo storage (private Vercel Blob store)
# BLOB_READ_WRITE_TOKEN=

# Required for quote notification email (Resend)
# RESEND_API_KEY=

# Optional overrides (defaults: info@mcshandymen.com)
# RESEND_FROM=MCS Handymen <info@mcshandymen.com>
# QUOTE_NOTIFY_TO=info@mcshandymen.com

# --- MCS Command Center (Phase 1+) ---
# Owner email used at /login (defaults to QUOTE_NOTIFY_TO or info@mcshandymen.com)
# CC_OWNER_EMAIL=info@mcshandymen.com

# Session signing secret — generate with:
#   node scripts/generate-cc-session-secret.mjs
# CC_SESSION_SECRET=

# Password hash — generate with:
#   node scripts/hash-owner-password.mjs "your-strong-password"
# Format uses ":" separators (not "$") so Next.js env loading cannot expand values.
# CC_OWNER_PASSWORD_HASH=scrypt:16384:8:1:...

# --- MCS Command Center Phase 2+ (Neon Postgres) ---
# Neon connection string (Vercel Marketplace or console.neon.tech).
# Quote submissions still succeed if this is missing or broken.
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Apply schema:
#   node scripts/cc-migrate.mjs

# --- MCS Command Center Phase 4A (Lead Agent, read-only) ---
# OpenAI API key for on-demand Analyze Lead (never expose to the browser).
# OPENAI_API_KEY=
#
# Optional provider/model (defaults shown). Model must support structured outputs.
# MCS_LEAD_AGENT_PROVIDER=openai
# MCS_LEAD_AGENT_MODEL=gpt-4o-mini

# --- Google Calendar sync (GC-2, Development only until Production cutover) ---
# Master switch. Must be exactly "true". Preview deployments always ignore this.
# GOOGLE_CALENDAR_SYNC_ENABLED=true
#
# OAuth client (Dev project). Redirect must match Google Cloud Console exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/oauth/callback
#
# AES-256-GCM key material for refresh-token ciphertext (never commit real values).
# GOOGLE_TOKEN_ENCRYPTION_KEY=
#
# Allowed business Google account (case-insensitive). Default: info@mcshandymen.com
# GOOGLE_ALLOWED_ACCOUNT_EMAIL=info@mcshandymen.com
#
# Tests / managed :3010 — leave sync disabled or use GOOGLE_CALENDAR_PROVIDER=mock
# GOOGLE_CALENDAR_PROVIDER=mock
